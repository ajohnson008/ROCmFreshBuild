#!/usr/bin/env python3.11
"""
TheRockBuilder - Main orchestration script

Usage:
    ./rb prep full          # Run full prep pipeline
    ./rb build full         # Run full build pipeline
    ./rb policy verify      # Run policy checks
    ./rb sync-mirrors       # Sync git mirrors
    ./rb prefetch-flake-inputs  # Prefetch flake inputs
    ./rb offline-proof      # Run offline proofing
"""

import argparse
import os
import subprocess
import sys
import time
from pathlib import Path


def run_command(cmd, cwd=None, check=True):
    """Run a command with proper output streaming"""
    print(f"Running: {' '.join(cmd)}")
    result = subprocess.run(cmd, cwd=cwd, check=check)
    return result


def cmd_prep(args):
    """Run prep pipeline"""
    print("=== Running Prep Pipeline ===")
    
    run_id = args.run_id if hasattr(args, 'run_id') and args.run_id else f"run-{int(time.time())}"

    # Policy check
    run_command(["python3.11", "tools/policy/policy_fence.py", "--run-id", run_id])

    # Sync mirrors
    run_command(["python3.11", "tools/mirror/sync_git_mirrors.py",
                "--lock", "pinned/rocm/7.2.0/source-lock.json",
                "--output", "mirrors/git"])

    run_command(["python3.11", "tools/mirror/sync_blobs.py",
                "--lock", "pinned/rocm/7.2.0/source-lock.json",
                "--output", "mirrors/blobs"])

    # Prefetch flake inputs
    run_command(["python3.11", "tools/prefetch/prefetch_flake_inputs.py"])

    # Offline proof
    run_command(["python3.11", "tools/offline_proof.py", run_id])

    # Generate locks
    run_command(["python3.11", "tools/lock/gen_source_lock.py",
                "--manifest", "pinned/rocm/7.2.0/default.xml",
                "--output", "pinned/rocm/7.2.0/source-lock.json",
                "--run-id", run_id])

    print("=== Prep Pipeline Complete ===")


def cmd_build(args):
    """Run build pipeline"""
    print("=== Running Build Pipeline ===")
    
    run_id = args.run_id if hasattr(args, 'run_id') and args.run_id else f"run-{int(time.time())}"
    target = os.environ.get("ROCM_BUILD_TARGET", "gfx110x")

    # Use the build driver
    run_command(["python3.11", "tools/build/build_driver.py",
                "--order", "graph/order.json",
                "--repo-root", ".",
                "--run-id", run_id,
                "--target", target])

    print("=== Build Pipeline Complete ===")


def cmd_policy_verify(args):
    """Run policy verification"""
    run_command(["python3", "tools/policy/policy_fence.py"])


def cmd_sync_mirrors(args):
    """Sync mirrors"""
    run_command(["python3", "tools/mirror/sync_git_mirrors.py",
                "--lock", "pinned/rocm/7.2.0/source-lock.json",
                "--output", "mirrors/git"])

    run_command(["python3", "tools/mirror/sync_blobs.py",
                "--lock", "pinned/rocm/7.2.0/source-lock.json",
                "--output", "mirrors/blobs"])


def cmd_prefetch_flake_inputs(args):
    """Prefetch flake inputs"""
    run_command(["python3", "tools/prefetch/prefetch_flake_inputs.py"])


def cmd_offline_proof(args):
    """Run offline proofing"""
    run_command(["python3", "tools/offline_proof.py"])


def main():
    parser = argparse.ArgumentParser(description="TheRockBuilder orchestrator")
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # Prep command
    prep_parser = subparsers.add_parser("prep", help="Run prep pipeline")
    prep_parser.add_argument("mode", choices=["full"], help="Prep mode")
    prep_parser.add_argument("--run-id", help="Override Run ID")

    # Build command
    build_parser = subparsers.add_parser("build", help="Run build pipeline")
    build_parser.add_argument("mode", choices=["full"], help="Build mode")
    build_parser.add_argument("--run-id", help="Override Run ID")

    # Policy command
    policy_parser = subparsers.add_parser("policy", help="Policy operations")
    policy_subparsers = policy_parser.add_subparsers(dest="policy_command")
    policy_subparsers.add_parser("verify", help="Verify policy compliance")

    # Mirrors command
    subparsers.add_parser("sync-mirrors", help="Sync git mirrors")

    # Prefetch command
    subparsers.add_parser("prefetch-flake-inputs", help="Prefetch flake inputs")

    # Offline proof command
    subparsers.add_parser("offline-proof", help="Run offline proofing")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return

    # Dispatch to appropriate handler
    if args.command == "prep":
        if args.mode == "full":
            cmd_prep(args)
        else:
            print("Usage: ./rb prep full")
            sys.exit(1)

    elif args.command == "build":
        if args.mode == "full":
            cmd_build(args)
        else:
            print("Usage: ./rb build full")
            sys.exit(1)

    elif args.command == "policy":
        if hasattr(args, 'policy_command') and args.policy_command == "verify":
            cmd_policy_verify(args)
        else:
            print("Usage: ./rb policy verify")
            sys.exit(1)

    elif args.command == "sync-mirrors":
        cmd_sync_mirrors(args)

    elif args.command == "prefetch-flake-inputs":
        cmd_prefetch_flake_inputs(args)

    elif args.command == "offline-proof":
        cmd_offline_proof(args)

    else:
        parser.print_help()


if __name__ == "__main__":
    main()