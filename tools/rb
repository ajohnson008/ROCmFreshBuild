#!/usr/bin/env python3.11
import sys
import argparse
import subprocess
from pathlib import Path

# Add tools dir to path
sys.path.append(str(Path(__file__).parent))

from policy import policy_fence
# from tooling import prefetch # Placeholder if needed, or inline
# We'll rely on imports inside conditions to avoid circular issues or early failures

RB_VERSION = "6.0"

def sync_mirrors(repo_root):
    """
    Executes mirror synchronization for git and blobs.
    Streams output directly to console.
    """
    print("🚀 [rb] Starting Mirror Synchronization...")
    
    # Sync Git Mirrors
    print("\n📦 [1/2] Syncing Git Mirrors...")
    git_sync_cmd = [
        "python3.11", 
        "tools/mirror/sync_git_mirrors.py",
        "--lock", "pinned/rocm/7.2.0/source-lock.json",
        "--output", "mirrors/git",
        "--workers", "4"
    ]
    try:
        subprocess.run(git_sync_cmd, cwd=repo_root, check=True)
    except subprocess.CalledProcessError as e:
        print(f"❌ Git mirror sync failed with exit code {e.returncode}")
        return False

    # Sync Blobs
    print("\n📦 [2/2] Syncing Blob Mirrors...")
    blob_sync_cmd = [
        "python3.11",
        "tools/mirror/sync_blobs.py",
        "--lock", "pinned/rocm/7.2.0/source-lock.json",
        "--output", "mirrors/blobs",
        "--workers", "4"
    ]
    try:
        subprocess.run(blob_sync_cmd, cwd=repo_root, check=True)
    except subprocess.CalledProcessError as e:
        print(f"❌ Blob mirror sync failed with exit code {e.returncode}")
        return False
        
    print("\n✅ Mirror Synchronization Complete")
    return True

def prefetch_flake(repo_root):
    print("Prefetching flake inputs (recursive)...")
    cmd = ["nix", "flake", "prefetch", "--extra-experimental-features", "nix-command flakes"]
    subprocess.run(cmd, cwd=repo_root, check=True)

def main():
    parser = argparse.ArgumentParser(description="TheRockBuilder (rb) Management Tool")
    parser.add_argument("--version", action="version", version=f"rb {RB_VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # Policy subcommand
    policy_parser = subparsers.add_parser("policy")
    policy_subparsers = policy_parser.add_subparsers(dest="policy_command", required=True)
    
    verify_parser = policy_subparsers.add_parser("verify")
    verify_parser.add_argument("--run-id", help="Run ID")
    verify_parser.add_argument("--strict", action="store_true", help="Enable strict mode")

    # Env subcommand (Phase C)
    env_parser = subparsers.add_parser("env")
    env_subparsers = env_parser.add_subparsers(dest="env_command", required=True)
    
    nix_opts_parser = env_subparsers.add_parser("nix-opts")
    nix_opts_parser.add_argument("--mode", choices=["online-sync", "offline", "mirror-only"], required=True)
    
    assert_sandbox_parser = env_subparsers.add_parser("assert-sandbox")

    # Offline Proof subcommand (Phase D)
    proof_parser = subparsers.add_parser("offline-proof")
    proof_parser.add_argument("--run-id", required=True)
    proof_parser.add_argument("--scope", choices=["graph", "build", "all"], default="all")

    # Helper commands
    sync_mirrors_parser = subparsers.add_parser("sync-mirrors")
    prefetch_flake_parser = subparsers.add_parser("prefetch-flake-inputs")

    args = parser.parse_args()
    repo_root = Path.cwd() # Assume running from root or find root

    # Ensure we are in repo root or find it
    if not (repo_root / "flake.nix").exists():
        # Try parent
        if (repo_root.parent / "flake.nix").exists():
            repo_root = repo_root.parent
        # Else warn?

    if args.command == "policy":
        if args.policy_command == "verify":
            policy_fence.verify(repo_root, args.run_id, args.strict)
    
    elif args.command == "env":
        from env_manager import handle_nix_opts, handle_assert_sandbox
        if args.env_command == "nix-opts":
            opts = handle_nix_opts(args.mode)
            print(" ".join(opts))
        elif args.env_command == "assert-sandbox":
            handle_assert_sandbox(repo_root)

    elif args.command == "offline-proof":
         from offline_proof import run_proof
         run_proof(repo_root, args.run_id, args.scope)
         
    elif args.command == "sync-mirrors":
        sync_mirrors(repo_root)

    elif args.command == "prefetch-flake-inputs":
        prefetch_flake(repo_root)

if __name__ == "__main__":
    main()
