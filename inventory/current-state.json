{
  "flake_outputs": {
    "packages": [
      "default",
      "ai-stack",
      "rocm-core",
      "numpy",
      "pytorch-rocm",
      "torchvision",
      "torchaudio",
      "flash-attention",
      "xformers",
      "deepspeed",
      "bitsandbytes",
      "vllm",
      "llamacpp-gpu",
      "llamacpp-cpu",
      "onnxruntime",
      "model-manager",
      "gcc14",
      "dependency-auditor",
      "build-orchestrator"
    ],
    "apps": [],
    "checks": []
  },
  "scripts": {
    "build_and_install.sh": {
      "path": "./scripts/build_and_install.sh",
      "description": "Builds the system config"
    },
    "audit-rocm-pins.sh": {
      "path": "./scripts/audit-rocm-pins.sh",
      "description": "Audits ROCm pin references in flake.nix"
    },
    "verify_sources.py": {
      "path": "./verify_sources.py",
      "description": "Python verification script"
    },
    "verify_sources_fast.sh": {
      "path": "./verify_sources_fast.sh",
      "description": "Fast verification shell script"
    }
  },
  "filesystem_layout": {
    "runs_dir_exists": false,
    "mirrors_dir": "mirrors",
    "pinned_dir": "pinned",
    "log_files": [
      "build.log",
      "build_debug.log",
      "build_verbose.log",
      "rocm-device-libs.log",
      "rocm-runtime.log",
      "source.log"
    ]
  },
  "policy_hooks": {
    "existing": [
      "scripts/audit-rocm-pins.sh"
    ],
    "status": "ad-hoc"
  },
  "rocm_state": {
    "pinned_version": "7.2.0 (directory exists)",
    "enforcement": "weak (grep-based in audit script)"
  }
}